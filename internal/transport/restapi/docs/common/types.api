syntax = "v1"

// 跨功能组共享的类型。
//
// StatusResp 被三个组引用，因此必须定义在此处 —— 放进任一组，另两组引用时
// goctl 会报未定义；各组各定义一份，又会报类型重名。
//
//   approver  DecideApproval
//   dataset   DeleteDataset、DeleteDocument
//   admin     GrantAgentDataset、RevokeAgentDataset
//
// 判断标准：只有被两个及以上功能组引用的类型才放这里。
// 单一功能组专用的类型一律放该组自己的 .api，不要图省事堆到 common，
// 否则这个文件会退化成新的「大杂烩」。
//
// DatasetListResp / DocumentListResp 都归 dataset 组所有（定义在 dataset.api）。
// goctl 会先合并所有 import，所以跨文件引用有效，但「能被引用」不等于「该被引用」：
// 分页后的 DatasetListResp 带 total/page/page_size，被「按主体列举授权」这种只有
// 一页的列表引用就会把分页字段读成 0，故 admin 组那边自持 AgentDatasetListResp。

type StatusResp {
	Status string `json:"status"`
}
