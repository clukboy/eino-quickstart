syntax = "v1"

// org 控制台接口。路由路径保持 /api/v1 不变，group 只负责生成代码分包。
import "types.api"

@server (
	prefix: /api/v1
	group: console/org
	middleware: RoleAdmin
)
service restapi {
	@handler ListOrgUnits
	get /org-units returns (OrgUnitListResp)

	@handler CreateOrgUnit
	post /org-units (CreateOrgUnitReq) returns (OrgUnitResp)

	@handler UpdateOrgUnit
	put /org-units/:id (UpdateOrgUnitReq) returns (OrgUnitResp)

	@handler DeleteOrgUnit
	delete /org-units/:id (OrgUnitIDReq) returns (StatusResp)

	@handler ListOrgMembers
	get /org-units/:id/members (OrgMemberListReq) returns (OrgMemberListResp)

	@handler AddOrgMember
	post /org-units/:id/members (AddOrgMemberReq) returns (OrgMemberResp)

	@handler RemoveOrgMember
	delete /org-units/:id/members/:subject (RemoveOrgMemberReq) returns (StatusResp)

}
