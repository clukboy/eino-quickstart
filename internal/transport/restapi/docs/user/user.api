syntax = "v1"

// 账号管理（管理后台）。
//
// 本组 3 条路由统一挂 RoleAdmin：账号的创建与查看是管理动作，普通登录用户
// （agent）不该看到「系统里还有哪些人」。
//
// ── 一条必须先说清的推论 ────────────────────────────────────────────
//
// 建号接口**不接受 role 参数**（见 internal/platform/auth/account.go 与
// persistence/account.Create 的签名）：新账号一律是 agent。这就意味着管理后台
// 造不出第二个管理员 —— 要给某人提权只能改库
// （UPDATE users SET role='admin'），而管理后台本身继续靠构建期注入的静态
// admin key 访问。这是「不允许注册」这条需求的直接后果，不是遗漏。
//
// 如果哪天要让界面能造管理员，正确的改法是给 CreateUserReq 加 role 字段并
// 在 handler 里限制取值，而不是去改 store.Create 的签名 —— 那层是刻意做成
// 「调用方拿不到提权能力」的。
//
// ── 没有的接口，以及为什么 ──────────────────────────────────────────
//
// 没有删除、停用、重置密码、改角色：本次不做（见 docs/known-gaps.md）。
// 尤其「停用」要注意它挡不住已签发的令牌 —— 账号令牌是无状态的
// （internal/platform/auth/account.go），status 只在**登录时**被检查，
// 一枚已经发出去的令牌会一直有效到 exp。
//
// 同样**没有「改昵称」的接口**：昵称在建号时定下来，之后只能改库。这与上面
// 那几条同源 —— 本组至今没有任何 Update 类端点。真要做的话，加
// PATCH /users/:id 时别忘了同步 restapi/routes_test.go 里那张**手工维护**的
// 期望路由表，否则 TestRoutingContract 会直接失败。
//
// ── 与「同步」的关系 ────────────────────────────────────────────────
//
// /users/sync 从 provider-neutral 外部数据源批量同步账号。它与上面两条
// 路由共用同一组、同一个中间件；未启用外部 source 时由业务层返回 503，
// dryRun、稳定 external_id 匹配和 no-delete 边界由实现与验收文档共同定义。
type UserResp {
	ID      uint64 `json:"id"`
	Subject string `json:"subject"`
	Username string `json:"username"`
	Nickname string `json:"nickname"`
	Role string `json:"role"`
	Status string `json:"status"`
	MustChangePassword bool `json:"must_change_password"`
	CreatedAt int64 `json:"created_at"`
}

// 响应里**没有** password / password_hash 字段，这是刻意的：哈希只存在于
// 后端，见 internal/platform/auth 与 persistence/account 的 Record（那个类型
// 专门做成不含哈希，让「顺手带出去」在类型上就不可能）。
type UserListResp {
	Data []UserResp `json:"data"`
	// Total 是**过滤后**的命中总数（keyword 生效之后还有多少条），**不是**
	// len(Data)。分页之前这两者恒相等，现在只有「一页装得下」时才相等 ——
	// 拿 len(Data) 去算总页数会少算。keyword 为空时它就是账号总数。
	Total int `json:"total"`
	Page int `json:"page"`
	PageSize int `json:"page_size"`
}

// UserListReq 是列表的查询条件。
//
// ⚠️ Keyword 必须带 `optional` 关键字：go-zero 的请求解析只认 optional（见
// core/mapping），漏掉它就会把这个查询参数当成**必填**，于是不带 ?keyword=
// 的请求直接 400 `field "keyword" is not set` —— 而「不做搜索」恰恰是最常见
// 的调用方式。
type UserListReq {
	// Keyword 按**用户名或昵称**做大小写不敏感的模糊匹配（子串），两端空白
	// 会被去掉。留空或不传表示不过滤，行为与没有这个参数时完全一致。
	//
	// 关于通配符：匹配走 ent 的 ContainsFold（PostgreSQL 上生成 ILIKE），它会
	// 对用户输入里的 % 与 _ 做转义，所以搜 "a_b" 不会命中 "axb"、搜 "%" 也不会
	// 命中全部。这一点由库保证，后端不需要再包一层转义。
	Keyword string `form:"keyword,optional"`
	// Page / PageSize 与 /runs、/tools、/audit-logs 同一口径：page 从 1 开始；
	// page_size <= 0 或 > 200 时后端按 20 兜底（不是报错 —— 上限是服务端资源
	// 约束，不该让调用方猜）。两个都不传 = 第一页 20 条。
	//
	// ⚠️ 必须带 `optional`，理由同 Keyword：漏掉它会让「不带分页参数」这个最
	// 常见的调用方式直接 400。字段名是 page_size，不是 pageSize。
	Page     int `form:"page,optional"`
	PageSize int `form:"page_size,optional"`
}

type CreateUserReq {
	Username string `json:"username"`
	// Nickname 是显示名，**必填**：空串或全空白会被 400（长度上界见
	// logic/user/helpers.go 的 nicknameLimit）。规则与提示文案也要和前端
	// 表单逐字对应，否则管理员会收到一条「按提示做却还是不通过」的报错。
	//
	// 它没有 optional 关键字，所以按 go-zero 的规则是**必填标量**：即使要传
	// 空值，字段本身也必须出现在请求体里，否则 400
	// `field "nickname" is not set`。这与下面 Password 的处理一致。
	Nickname string `json:"nickname"`
	// Password 是**管理员设定的初始密码**。
	//
	// 它只能用一次：服务端把新账号的 must_change_password 设为真，这个身份在
	// 改密之前除了 /api/v1/auth/* 之外什么都访问不了
	// （middleware/password_guard.go）。这一点必须让管理员知道 —— 他手上这枚
	// 密码在对方首次登录后就作废了，而不是一直可用。
	//
	// 同时注意：管理员知道这个密码，所以它是**共享凭证**而不是对方的私密凭证，
	// 这正是「首次强制改密」存在的理由。也要注意它没有下限以外的强度要求，
	// 校验在 logic/user/create_user_logic.go 里。
	Password string `json:"password"`
}

type UserPathReq {
	ID uint64 `path:"id"`
}

type UpdateUserReq {
	ID       uint64 `path:"id"`
	Nickname string `json:"nickname,optional"`
	Role     string `json:"role,optional"`
	Status   string `json:"status,optional"`
}

type ResetUserPasswordReq {
	ID       uint64 `path:"id"`
	Password string `json:"password"`
}

type SyncUsersReq {
	DryRun bool `json:"dryRun,optional"`
}

// SyncUsersResp 是一次同步的可审计摘要。errors 只包含外部用户键与可操作原因，
// 不包含上游令牌、密码或原始响应。created 的 initialPassword 仅在本次响应返回。
type SyncUsersResp {
	DryRun bool `json:"dryRun"`
	Total int `json:"total"`
	Created int `json:"created"`
	Updated int `json:"updated"`
	Skipped int `json:"skipped"`
	Failed int `json:"failed"`
	CreatedUsers []SyncCreatedUser `json:"createdUsers,omitempty"`
	Errors []SyncUserError `json:"errors,omitempty"`
}

type SyncCreatedUser {
	ExternalID string `json:"externalId"`
	Username string `json:"username"`
	InitialPassword string `json:"initialPassword"`
}

type SyncUserError {
	ExternalID string `json:"externalId,omitempty"`
	Username string `json:"username,omitempty"`
	Reason string `json:"reason"`
}

// 账号创建与查看全部需要 admin 角色。
@server (
	prefix:     /api/v1
	group:      user
	middleware: RoleAdmin
)
service restapi {
	@doc "列出账号（按创建时间倒序分页；keyword 可按用户名或昵称模糊搜索）"
	@handler ListUsers
	get /users (UserListReq) returns (UserListResp)

	@doc "创建账号（角色固定 agent，初始密码由管理员设定并强制首登改密）"
	@handler CreateUser
	post /users (CreateUserReq) returns (UserResp)

	// 同步只新增或更新，不删除本地账号。dryRun=true 只拉取并计算差异，不写库；
	// 创建的新账号会返回一次性初始密码，服务端不会把它写入日志。
	@doc "从已配置的外部数据源同步账号（只新增/更新，不删除；支持 dry-run）"
	@handler SyncUsers
	post /users/sync (SyncUsersReq) returns (SyncUsersResp)

	@handler UpdateUser
	patch /users/:id (UpdateUserReq) returns (UserResp)

	@handler ResetUserPassword
	post /users/:id/password (ResetUserPasswordReq) returns (StatusResp)
}
