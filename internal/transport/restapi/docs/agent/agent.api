syntax = "v1"

// 会话。
//
// 本组三条路由，是「会话」这件事的完整读写面：
//   POST /sessions                  开一个会话，客户端拿到 session_id 才能真的对话
//                                   （turn 与 run 的写入都要求会话行已落库）
//   GET  /sessions                  列出自己的会话，按最后活动时间倒序
//   GET  /sessions/:id/messages     列出某个会话的历史消息
//
// 写作侧先有、读侧后补：会话行与消息一直是在写的（POST /sessions 落 sessions，
// 对话时落 chat_turns 与 session_messages），但**读回来的接口是后加的** ——
// 在此之前客户端只能把会话放在自己的内存里，刷新即丢。所以「会话持久化」这件
// 事的实际内容是这两个 GET，而不是写作侧。
//
// 本组三条都带 RoleAgent。owner 一律取自 token 的 subject，**接口上没有任何
// 「owner 参数」可以传** —— 越权的口径由 Store 统一成「查不到」，
// 见 internal/platform/persistence/session 的 getOwned。
//
// 真正的对话入口 POST /api/v1/chat 是 SSE 流式路由，按「一个子文件 = 一个功能组」
// 归在 stream 组（stream/stream.api），那一组整组带 sse: true 开关。
//
// ── 为什么没有分页、没有删除、没有改名 ──────────────────────────────
//
// 没有分页：会话按 owner 切分之后量级很小，而且侧栏是「一屏滚完」的交互，
// 翻页反而更差。真要加，形态应该是 limit + updated_at 游标，而不是 offset ——
// 但那需要一个真实的量级理由，现在没有。
// （注意：控制台那批列表接口已经陆续改成 page/page_size 了，所以「本仓库的列表
// 接口都是全量返回」这句话不再成立；分页与否按各接口自己的场景定。）
//
// 没有删除 / 改名：sessions 表目前**没有任何删除路径**，而 session_messages 与
// chat_turns 对它的外键是 NoAction（不是级联），删一条会话要按序清三张表
// （assistant/user 两种消息、轮次记录、会话行）。那是个独立的设计题，
// 不要顺手塞进这一组做个半成品。

type CreateSessionResp {
	SessionID string `json:"session_id"`
}

// SessionResp 是会话列表里的一条。
//
// 时间用毫秒时间戳，与本仓库其它接口一致（UnixMilli）。
type SessionResp {
	SessionID string `json:"session_id"`
	// Title 是首条用户消息的截断（服务端派生，客户端只读）。
	// **空串是合法值**，含义是「这条会话还没有人说过话」，界面显示「新对话」。
	// 所以客户端不要把它当缺失来兜底成别的文案 —— 空串本身就是那个状态。
	//
	// 派生规则见 internal/platform/persistence/session 的 DeriveTitle，
	// 前端 src/api/model/chat.ts 的 sessionTitleFrom 是它的镜像实现
	// （新建会话后、服务端标题回来之前的本地占位）。两边改要一起改。
	Title string `json:"title"`
	// CreatedAt 是会话创建时刻。
	CreatedAt int64 `json:"created_at"`
	// UpdatedAt 是最后活动时刻（每轮对话的 Start 与 Complete 各刷一次），
	// 列表就是按它倒序的。它同时也是「这条会话最近被用过吗」的唯一依据。
	UpdatedAt int64 `json:"updated_at"`
}

type SessionListResp {
	Data []*SessionResp `json:"data"`
}

// SessionMessagesReq 的 ID 是**会话的对外 id**（uuid，即 session_id 列），
// 不是 sessions 表的自增主键 —— 列表接口返回的 session_id 直接填进来即可。
// 全库没有哪个接口暴露过 self-increment 主键，不要在这里开这个头。
type SessionMessagesReq {
	ID string `path:"id"`
}

// SessionMessageBlockResp 是一条消息里的一个展示单元。
//
// 为什么历史消息不能只有一个 content 字符串：一轮对话实际包含的不只是正文 ——
// 模型可能先调工具再作答，也可能只产出一张图。只给 content 的话，前端永远
// 看不到「检索过什么」，而「只有图片」的一轮甚至连 content 都没有。
//
// blocks 与 content **不是二选一**：content 是纯文本投影（服务端回喂模型用它），
// blocks 是给界面渲染的结构化视图。老数据没有 blocks（json 里是 null），
// 前端按「回退到 content」处理即可，不需要区分版本。
type SessionMessageBlockResp {
	// Type 是块类型，当前有 12 种（与模型协议的 ContentBlockType 一一对应地投影，
	// 但不是照抄：同一类语义的多个协议块会落到同一个展示类型上）：
	//
	//   text               正文（用户输入与模型输出都是）
	//   reasoning          模型的思考过程，text 字段承载，已按上限截断
	//   tool_call          调用工具，name + arguments；覆盖本地函数工具、模型服务端
	//                      内置工具（web_search 等）、MCP 工具
	//   tool_result        工具结果，name + summary（只有摘要，没有原文）
	//   tool_search        服务端工具检索的结果，summary 是「发现 N 个工具」
	//   mcp_tools          MCP 服务器的工具清单，name 是服务标签
	//   approval_request   工具调用等待审批，name + arguments
	//   approval_response  审批结论，summary 是「已批准 / 已拒绝」
	//   image / audio / video / file   多媒体，url / mime_type / filename
	//
	// 给 string 而不是枚举，理由与 role 相同：以后加一种块类型不该改动生成物，
	// 而前端的正确行为本来就是「不认识的类型跳过」。
	Type string `json:"type"`

	// Text 是 text 块的正文。流式回答的多个分片在服务端已经合并成一块，
	// 前端拿到的就是完整段落，不需要自己拼接。
	Text string `json:"text,omitempty"`

	// Name 是 tool_call / tool_result 的工具名。
	Name string `json:"name,omitempty"`

	// Arguments 是 tool_call 的入参 JSON，按服务端的工具输出上限截断过。
	Arguments string `json:"arguments,omitempty"`

	// Summary 是 tool_result 的一句话摘要，例如「召回 3 条」。
	//
	// 这里**刻意没有**工具结果正文：那是按提问当时的授权召回的原文，留在历史里
	// 等于给已撤销的授权留一条后门，而且体积不可控。要排查请查日志。
	Summary string `json:"summary,omitempty"`

	// URL / MIMEType / Filename 描述多媒体块。
	// 不返回 base64 原文：内联进 JSON 会让一条消息变成几 MB。
	URL      string `json:"url,omitempty"`
	MIMEType string `json:"mime_type,omitempty"`
	Filename string `json:"filename,omitempty"`
}

// SessionMessageResp 是一条历史消息。
type SessionMessageResp {
	ID uint64 `json:"id"`
	// Role 只有 "user" / "assistant" 两种，取值与 eino schema.RoleType 的字符串
	// 形式一致（写入侧就是 string(schema.User) / string(schema.Assistant)）。
	//
	// 这里给的是 string 而不是枚举：真要枚举，加一种角色就要动生成物，
	// 而前端的正确行为本来就是「不认识的角色按普通气泡显示」。
	Role string `json:"role"`
	// Content 是全文，不做截断。会话历史与知识库召回不同 —— 召回要按字节
	// 上限截断（正文可能几十 KB），历史消息是用户自己说过的话，截了没有意义。
	Content   string `json:"content"`
	CreatedAt int64  `json:"created_at"`
	// Blocks 是结构化展示块，按实际发生顺序排列（先说的话在前）。
	//
	// 为 null 只表示「这条消息没有 blocks」—— 存量老数据全是这样，新建的
	// user 消息也是（用户输入本来就是纯文本）。前端遇到 null 就渲染 Content。
	Blocks []*SessionMessageBlockResp `json:"blocks,omitempty"`
}

type SessionMessagesResp {
	Data []*SessionMessageResp `json:"data"`
}

// 会话需要 agent 角色。
@server (
	prefix:     /api/v1
	group:      agent
	middleware: RoleAgent
)
service restapi {
	@doc "创建会话"
	@handler CreateSession
	post /sessions returns (CreateSessionResp)

	@doc "列出我的会话（按最后活动时间倒序）"
	@handler ListSessions
	get /sessions returns (SessionListResp)

	@doc "列出会话的历史消息"
	@handler ListSessionMessages
	get /sessions/:id/messages (SessionMessagesReq) returns (SessionMessagesResp)
}
